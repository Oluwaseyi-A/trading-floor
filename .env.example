# Trading Floor — public demo
# Copy to .env and fill in. Never commit .env.

# Required for the trader / researcher LLM agents
OPENAI_API_KEY=

# Optional model providers (USE_MANY_MODELS=true uses these)
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Required for the researcher's web search MCP
BRAVE_API_KEY=

# Optional — free EOD path is used if blank
POLYGON_API_KEY=

# Behavior
USE_MANY_MODELS=false
RUN_EVERY_N_MINUTES=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=true

# Public-app guardrails (hosted only; CLI ignores these)
MAX_RUNS_PER_SESSION=10
SESSION_MAX_MINUTES=10
